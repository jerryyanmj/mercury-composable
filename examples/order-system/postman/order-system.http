# Order Fulfillment System

###
# group: 01. Happy Path
# @name 1. Submit Order  (external party -> orders.inbound)
# The real ingress: an external party publishes the order onto Kafka. The manager consumes it into the order-intake-event flow.
POST {{mock}}/api/v1/mock/order
Content-Type: application/json

{
  "order_id": "O-HAPPY-{{$timestamp}}",
  "external_party": "acme",
  "route": "steward-1",
  "payload": {
    "item": "widget",
    "qty": 2,
    "amount": 500
  }
}

> {%
    // TODO: migrate to HTTP Client Response handler API
    // pm.test("published to orders.inbound", () => pm.response.to.have.status(202));
    // const b = pm.response.json();
    // pm.test("topic is orders.inbound", () => pm.expect(b.topic).to.eql("orders.inbound"));
    // pm.collectionVariables.set("order_id", b.order_id);
%}

###
# group: 01. Happy Path
# @name 2. Trigger Manager Outbox Relay
# Drains the manager outbox to Kafka. In DEMO_MODE the scheduler does nothing, so this is what moves the order to the steward.
POST {{manager}}/api/v1/admin/relay

> {%
    // TODO: migrate to HTTP Client Response handler API
    // pm.test("Trigger Manager Outbox Relay", () => pm.response.to.have.status(200));
    // const b = pm.response.json();
    // console.log("relayed/ticked:", JSON.stringify(b));
%}

###
# group: 01. Happy Path
# @name 3. Capture Fulfillment Id
# The Kafka ingress does not answer with a fulfillment id (nobody is waiting), so it is read back from the manager and stored for the SoR steps below.
GET {{manager}}/api/v1/order/{{order_id}}

> {%
