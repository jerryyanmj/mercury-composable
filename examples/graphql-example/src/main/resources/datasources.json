[
  {
    "name": "userService",
    "type": "REST",
    "baseUrl": "http://localhost:9090",
    "endpoints": {
      "getUser": {
        "path": "/api/user/{id}",
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        },
        "responseMapping": {
          "id": "$.id",
          "name": "$.name",
          "email": "$.email",
          "fullName": "$.fullName",
          "hobbies": "$.hobbies",
          "phone": "$.phone",
          "address": "$.address"
        }
      }
    }
  },
  {
    "name": "postService",
    "type": "REST",
    "baseUrl": "http://localhost:9090",
    "endpoints": {
      "getPost": {
        "path": "/api/post/{id}",
        "method": "GET",
        "responseMapping": {
          "id": "$.id",
          "title": "$.title",
          "content": "$.content",
          "createdAt": "$.createdAt",
          "updatedAt": "$.updatedAt",
          "author": "$.author",
          "tags": "$.tags"
        }
      },
      "getPostsByUser": {
        "path": "/api/posts?userId={userId}",
        "method": "GET",
        "responseMapping": {
          "id": "$.id",
          "title": "$.title",
          "content": "$.content",
          "createdAt": "$.createdAt"
        }
      }
    }
  }
]